{  
  "compilerOptions": {
    "lib": ["dom", "esnext"],
    "strict": true,
    "jsx": "react-jsx",
    "jsxFactory": "buildJsx",
    "jsxFragmentFactory": "jsxFragment",
    "jsxImportSource": "jsx",
    "types": ["./src/libs/jsxTypes.d.ts"]
  },
  "tasks": {
    "dev": "deno run --allow-all --watch=./esbuild.ts,./src,./static ./esbuild.ts"
    "build": "deno run --allow-all ./esbuild.ts"
    "serve": "livehttpd -a 127.0.0.1 ./dist"
  },
  "imports": {
    "@luca/esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@^0.11.1",
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@^1.0.9",
    "colorjs.io": "npm:colorjs.io@^0.5.2",
    "esbuild": "npm:esbuild@^0.25.4",
    "jsx/jsx-runtime": "./src/libs/buildJsx.ts",
  }
}
